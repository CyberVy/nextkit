{
  "name": "nextkit",
  "title": "NextKit",
  "description": "Create Apps with NextKit",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "nextkit": "./cli/dist/index.js"
  },
  "scripts": {
    "cli": "node cli/dist/index.js",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=cli/dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "prepare": "npm run build:cli",
    "tauri": "cargo tauri",
    "dev:debug_bridge": "npx tsx cli/debug/generate_debug_bridge.ts",
    "dev": "npx tsx cli/dev/dev.ts --port=4000",
    "build": "npm run build:sw & next build",
    "start": "npx serve out -p 4000",
    "lint": "eslint src cli",
    "dev:sw": "esbuild src/sw/main.worker.ts --bundle --format=esm --target=esnext --outfile=public/sw.js --watch=forever --banner:js=\"// Generated by src/sw/main.worker.ts\"",
    "build:sw": "esbuild src/sw/main.worker.ts --bundle --format=esm --target=esnext --outfile=public/sw.js --minify --banner:js=\"// Generated by src/sw/main.worker.ts\"",
    "dev:injection": "esbuild src-tauri/src/inject.ts --bundle --format=esm --target=esnext --outfile=src-tauri/src/inject.js --watch=forever --banner:js=\"// Generated by src-tauri/src/inject.ts\"",
    "build:injection": "esbuild src-tauri/src/inject.ts --bundle --format=esm --target=esnext --outfile=src-tauri/src/inject.js --minify --banner:js=\"// Generated by src-tauri/src/inject.ts\""
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "next": "16.3.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
